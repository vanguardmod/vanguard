# Build outputs
/build/
/build-*/
/cmake-build-*/

# Test server runtime artefacts
/scripts/testserver/server.log
/vanguard
/omni-bot
*.qvm
*.so
*.so.*
*.dll
*.dylib
*.exp
*.lib
*.pdb
# Generated multi-arch mod distribution archive (built by the mod_pk3 target
# in cmake/ETLBuildMod.cmake). The .pk3 the server hands out at connect time
# is a build output, not source.
*.pk3

# QVM toolchain intermediates
*.asm
*.obj
*.bytecode

# CMake artefacts
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
.DS_Store
Thumbs.db

# Local overrides (not for the repo)
local.cmake
*.local
.env
.env.local

# Bootstrap import staging
_sdk-import/
_etlegacy-import/

# Bootstrap-disabled upstream files (kept on disk, never committed)
*.disabled

# Build/run logs
build.log
*.log

# Proprietary Wolfenstein: Enemy Territory assets — Activision/Splash Damage
# These belong to a legitimate WET install and MUST NEVER be committed.
etmain/pak0.pk3
etmain/pak1.pk3
etmain/pak2.pk3
etmain/mp_bin.pk3

# Closed-source WolfGuard implementation (only on trusted core devs' machines)
wolfguard/private/

# Omni-Bot runtime cache (tarball + extracted tree). Downloaded by
# scripts/bootstrap.sh from mirror.etlegacy.com on first build with
# FEATURE_OMNIBOT=ON. Survives `rm -rf build` so we don't re-download
# every bootstrap. Not source — never committed.
vendor/omnibot-runtime/

# NTFS Alternate Data Streams — Windows / WSL2 attaches a
# `:Zone.Identifier` metadata file to anything downloaded via a web
# browser, marking origin URL + security zone. They surface as
# untracked siblings of the actual file in `git status` and have no
# business in version control.
*:Zone.Identifier
